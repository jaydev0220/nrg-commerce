{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "landing-local",
	"compatibility_date": "2026-07-23",
	"compatibility_flags": ["nodejs_compat"],
	"assets": {
		"directory": ".svelte-kit/cloudflare",
		"html_handling": "auto-trailing-slash",
		"not_found_handling": "404-page"
	},
	"workers_dev": false,
	"preview_urls": false,
	"env": {
		"production": {
			"name": "nrg-commerce-landing",
			"vars": {
				"PUBLIC_CDN_BASE_URL": "https://cdn.nrglabware.com",
				"PUBLIC_CTA_URL": "https://catalog.nrglabware.com",
				"PUBLIC_FACEBOOK_URL": "https://www.facebook.com/100057611824911",
				"PUBLIC_LINE_URL": "https://line.me/ti/p/xYZS-jqz4e",
				"PUBLIC_SITE_URL": "https://www.nrglabware.com",
				"PUBLIC_COOKIE_DOMAIN": "nrglabware.com",
				"PUBLIC_CONTACT_WORKER_URL": "https://contact.nrglabware.com",
				"PUBLIC_TURNSTILE_SITE_KEY": ""
			}
		}
	}
}
